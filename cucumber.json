{
  "default": {
    "paths": ["features/**/*.feature"],
    "require": ["features/**/*.js"],
    "format": [
      "progress-bar",
      "summary",
      "html:reportes/reporte.html",
      "json:reportes/reporte.json"
    ],
    "worldParameters": {
      "urlLogin": "https://cs.uns.edu.ar/~mll/temp/testing/hogwarts/login.html",
      "headless": true,
      "slowMo": 0
    }
  },
  "visible": {
    "paths": ["features/**/*.feature"],
    "require": ["features/**/*.js"],
    "format": [
      "progress-bar",
      "summary",
      "html:reportes/reporte.html",
      "json:reportes/reporte.json"
    ],
    "worldParameters": {
      "urlLogin": "https://cs.uns.edu.ar/~mll/temp/testing/hogwarts/login.html",
      "headless": false,
      "slowMo": 400
    }
  }
}
